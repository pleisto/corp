{
  "name": "@brickdoc/server-monolith",
  "private": true,
  "description": "It's a stub package for make turborepo could be work with rails",
  "license": "Apache-2.0",
  "version": "0.11.0",
  "volta": {
    "extends": "../../package.json"
  },
  "scripts": {
    "test:rspec": "bundle exec rspec",
    "bundle": "bundle",
    "rake": "rake",
    "rails": "rails",
    "start": "rails s",
    "i": "bundle install && rake rust:build",
    "s": "rails s",
    "g": "rails g",
    "c": "rails c",
    "db:create": "rails db:create",
    "db:drop": "rails db:drop",
    "db:migrate": "rails db:migrate",
    "db:rollback": "rails db:rollback",
    "console": "rails c",
    "lint:eslint": "TIMING=1 run -T eslint --cache --ext ts,tsx src",
    "lint:type": "run -T tsc",
    "lint:rubocop": "bundle exec rubocop --parallel --config .rubocop.yml",
    "lint:brakeman": "bundle exec brakeman  --no-pager --exit-on-warn",
    "lint:fix": "bundle exec rubocop --config .rubocop.yml -a && TIMING=1 run -T eslint --cache --ext ts,tsx app/frontend --fix",
    "vite:start": "./bin/vite dev",
    "vite:build": "./bin/vite build",
    "build": "rake rust:build",
    "build:dev": "rake rust:build PROFILE=dev",
    "lint:clippy": "rake rust:clippy",
    "fmt:rust": "rake rust:fmt"
  },
  "dependencies": {
    "@brickdoc/active-support": "workspace:^",
    "@brickdoc/design-system": "workspace:^",
    "@inertiajs/inertia": "^0.11.0",
    "@inertiajs/inertia-react": "^0.8.0",
    "@inertiajs/progress": "^0.2.7",
    "i18next": "^21.8.8",
    "i18next-http-backend": "^1.4.1",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-helmet-async": "^1.3.0",
    "react-i18next": "^11.17.0"
  }
}
