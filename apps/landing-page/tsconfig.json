{
  "extends": "../../tsconfig.shared.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "module": "esnext"
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "dist/**/*"
  ]
}
