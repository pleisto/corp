{
  "name": "@brickdoc/e2e-testing",
  "private": true,
  "scripts": {
    "install-deps": "yarn playwright install --with-deps",
    "start": "yarn run-playwright",
    "run-playwright": "yarn playwright test",
    "lint": "yarn lint:eslint && yarn lint:type",
    "lint:eslint": "TIMING=1 run -T eslint --cache --ext ts,tsx .",
    "lint:fix": "TIMING=1 run -T eslint --cache --ext ts,tsx . --fix",
    "lint:type": "run -T tsc"
  },
  "devDependencies": {
    "@playwright/test": "^1.21.1"
  }
}
