{
  "name": "@brickdoc/monorepo",
  "version": "0.0.0",
  "author": "Brickdoc LTD",
  "description": "Brickdoc Monorepo Root",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "foss/packages/design-icons",
    "foss/packages/design-system",
    "foss/packages/active-support",
    "foss/packages/test-helper",
    "apps/*",
    "tools/*",
    "plugins/*"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{json,yml,yaml,md,graphql,gql,css,js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "packages/brickdoc-design-icons/assets/**/*.svg": [
      "yarn design-icons generator"
    ],
    "apps/server-monolith/*.rs": [
      "cargo fmt --manifest-path=apps/server-monolith/Cargo.toml && :"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "postinstall": "husky install",
    "lint": "turbo run lint:eslint lint:type --filter=\"!./foss/**/*\"",
    "lint:eslint": "turbo run lint:eslint --filter=\"!./foss/**/*\"",
    "lint:fix": "turbo run lint:fix  --filter=\"!./foss/**/*\"",
    "lint:type": "turbo run lint:type --filter=\"!./foss/**/*\"",
    "test": "turbo run lint:type test:jest --filter=\"!./foss/**/*\"",
    "test:jest": "NODE_ENV=test turbo run test:jest --filter=\"!./foss/**/*\"",
    "commit": "git add . && cz"
  },
  "devDependencies": {
    "@brickdoc/eslint-plugin": "^1.0.2",
    "@commitlint/cli": "^17.0.2",
    "@commitlint/config-conventional": "^17.0.2",
    "@swc/cli": "^0.1.57",
    "@swc/jest": "^0.2.21",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/react-hooks": "^8.0.0",
    "@testing-library/user-event": "^14.2.0",
    "@types/is-ci": "^3.0.0",
    "@types/jest": "^28.1.1",
    "@types/jest-axe": "^3.5.3",
    "@types/node": "^17.0.41",
    "@types/rails__actioncable": "^6.1.6",
    "@types/rails__activestorage": "^7.0.1",
    "@types/react": "^18.0.12",
    "@types/react-dom": "^18.0.5",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^8.3.4",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "depcheck": "^1.4.3",
    "eslint": "^8.17.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "graphql-tag": "^2.12.6",
    "husky": "^8.0.1",
    "identity-obj-proxy": "^3.0.0",
    "is-ci": "^3.0.1",
    "jest": "^28.1.1",
    "jest-axe": "^6.0.0",
    "jest-environment-jsdom": "^28.1.1",
    "jest-junit": "^13.2.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "turbo": "^1.2.16",
    "typedoc": "^0.22.17",
    "typedoc-plugin-markdown": "^3.12.1",
    "typescript": "^4.7.3"
  },
  "packageManager": "yarn@3.2.1",
  "dependencies": {
    "@swc/core": "^1.2.197",
    "@swc/helpers": "^0.3.17",
    "dayjs": "^1.11.3",
    "ts-node": "^10.8.1"
  },
  "resolutions": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "volta": {
    "node": "18.2.0",
    "yarn": "1.22.18"
  }
}
