{
  "name": "@pleisto/corp-monorepo",
  "version": "0.0.0",
  "author": "Brickdoc LTD",
  "description": "Pleisto Internal Monorepo Root",
  "private": true,
  "workspaces": [
    "foss/packages/*",
    "foss/apps/*",
    "foss/tools/*",
    "foss/plugins/*",
    "packages/*",
    "apps/*",
    "tools/*",
    "plugins/*"
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{json,yml,yaml,md,mdx,graphql,gql,graphql,css,js,jsx,ts,tsx}": [
      "dev-support prettier --write"
    ],
    "*.code-workspace": [
      "dev-support prettier --parser json --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "postinstall": "(rm foss/yarn.lock || true) && (dev-support is-ci || husky install) && dev-support pdftron-post-setup",
    "rust:build": "SYSINFO=$(uname -a) turbo run rust:build --filter=\"!./foss/**/*\"",
    "rust:build:dev": "turbo run rust:build:dev --filter=\"!./foss/**/*\"",
    "lint": "turbo run lint:eslint lint:rubocop lint:type --filter=\"!./foss/**/*\"",
    "lint:eslint": "turbo run lint:eslint --filter=\"!./foss/**/*\"",
    "lint:rubocop": "turbo run lint:rubocop --filter=\"!./foss/**/*\"",
    "lint:type": "turbo run lint:type --filter=\"!./foss/**/*\"",
    "lint:fix": "turbo run lint:fix --filter=\"!./foss/**/*\"",
    "test": "SYSINFO=$(uname -a) turbo run test:jest test:rspec --filter=\"!./foss/**/*\"",
    "test:jest": "NODE_ENV=test turbo run test:jest --filter=\"!./foss/**/*\"",
    "test:rspec": "SYSINFO=$(uname -a) turbo run test:rspec --filter=\"!./foss/**/*\"",
    "tsdoc": "turbo run tsdoc --filter=\"!./foss/**/*\"",
    "commit": "git add . && cz",
    "cleanup": "rimraf node_modules/.cache '{packages,tools,apps}/*/{dist,coverage,.turbo,.nyc_output,.eslintcache,.next}'",
    "page": "yarn workspace @pleisto/mashcard-landing-page",
    "schema": "yarn workspace @mashcard/schema",
    "design-system": "yarn workspace @mashcard/design-system",
    "design-icons": "yarn workspace @mashcard/design-icons",
    "legacy-editor": "yarn workspace @mashcard/legacy-editor",
    "editor": "yarn workspace @mashcard/editor",
    "formula": "yarn workspace @mashcard/formula",
    "uploader": "yarn workspace @mashcard/uploader",
    "web": "yarn workspace @mashcard/client-web",
    "e2e-testing": "yarn workspace @mashcard/e2e-testing",
    "active-support": "yarn workspace @mashcard/active-support",
    "server": "yarn workspace @mashcard/server-monolith",
    "github-auth": "yarn workspace @mashcard/github-auth",
    "google-auth": "yarn workspace @mashcard/google-auth"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@mashcard/dev-support": "workspace:^",
    "@swc/cli": "^0.1.57",
    "@swc/jest": "^0.2.22",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^14.3.0",
    "@types/jest": "^28.1.6",
    "@types/jest-axe": "^3.5.4",
    "@types/node": "^18.6.1",
    "@types/rails__actioncable": "^6.1.6",
    "@types/rails__activestorage": "^7.0.1",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "commitizen": "^4.2.5",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^8.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^28.1.3",
    "jest-axe": "^6.0.0",
    "jest-environment-jsdom": "^28.1.3",
    "lint-staged": "^13.0.3",
    "rimraf": "^3.0.2",
    "turbo": "^1.3.4",
    "typescript": "^4.7.4"
  },
  "packageManager": "yarn@3.2.2",
  "resolutions": {
    "@rails/actioncable": "patch:@rails/actioncable@npm:7.0.3#foss/.yarn/patches/@rails-actioncable-npm-7.0.3-9e882d37e5.patch",
    "cpy": "npm:@pleisto/cpy@>=8.1.2-patch.1",
    "prosemirror-view": "patch:prosemirror-view@npm:1.27.0#foss/.yarn/patches/prosemirror-view-npm-1.27.0-fee90688e2.patch"
  },
  "dependencies": {
    "@swc/core": "^1.2.218",
    "@swc/helpers": "^0.4.3",
    "lodash-es": "^4.17.21",
    "ts-node": "^10.9.1"
  },
  "volta": {
    "extends": "./foss/package.json"
  }
}
